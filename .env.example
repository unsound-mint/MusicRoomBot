#env.example
BOT_TOKEN=
TIMEZONE=Asia/Almaty
LOG_LEVEL=INFO
ACCESS_FORM_URL=https://example.com/access-form

# Optional for Docker Compose. If DATABASE_URL is empty, Compose uses the
# postgres service with these credentials.
DATABASE_URL=
POSTGRES_DB=musicroom
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=musicroom

# Optional Docker DNS resolvers used by docker-compose.yml.
DOCKER_DNS_PRIMARY=1.1.1.1
DOCKER_DNS_SECONDARY=8.8.8.8

# SQLAlchemy pool tuning (Postgres)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Runtime config caching (seconds)
RUNTIME_CONFIG_CACHE_TTL=30
# Optional bootstrap default for runtime config; DB values still override this.
EQUIPMENT_TOPIC_ID=

# Optional bootstrap admin seed. If BOOTSTRAP_ADMIN_TG_ID is empty, no admin
# user is created by `python -m app.bootstrap`.
BOOTSTRAP_ADMIN_TG_ID=
BOOTSTRAP_ADMIN_TG_USERNAME=
BOOTSTRAP_ADMIN_FULL_NAME=Bootstrap Admin

# Optional bootstrap runtime config overrides. The bootstrap command reads
# BOOTSTRAP_CONFIG_<CONFIG_KEY> values, for example:
# BOOTSTRAP_CONFIG_ADMIN_CHAT_ID=
# BOOTSTRAP_CONFIG_MEMBER_CHAT_ID=
# BOOTSTRAP_CONFIG_MEMBER_TOPIC_ID=
# BOOTSTRAP_CONFIG_ACCESS_CHAT_ID=
# BOOTSTRAP_CONFIG_GEO_CENTER_LAT=
# BOOTSTRAP_CONFIG_GEO_CENTER_LON=

# Backpressure for booking flows (prevents DB pool exhaustion during spam)
BOOKING_MAX_IN_FLIGHT=10
BOOKING_ACQUIRE_TIMEOUT_S=0.05

# Per-user cooldown for "Book a slot" (seconds)
BOOKING_USER_COOLDOWN_S=2.0
